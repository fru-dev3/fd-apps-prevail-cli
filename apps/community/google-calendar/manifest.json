{
  "id": "google-calendar",
  "name": "Google Calendar",
  "version": "0.1.0",
  "description": "Manage events and find free time via an installed MCP server. Used by calendar and chief domains to weave meetings into daily briefings.",
  "domains": [
    "calendar",
    "chief"
  ],
  "integration": "mcp",
  "connection": "Wrapped via an MCP server installed locally. The server handles its own OAuth dance; prevail just needs to know the server binary is on PATH. Install via `npm i -g @anthropic-ai/mcp-server-gcal` (or whichever provider you use), then probe.",
  "auth_check": {
    "kind": "mcp",
    "mcp_command": "mcp-server-gcal"
  },
  "oauth": {
    "provider": "google",
    "client_id_env": "GOOGLE_CLIENT_ID",
    "client_secret_env": "GOOGLE_CLIENT_SECRET",
    "auth_url": "https://accounts.google.com/o/oauth2/v2/auth",
    "token_url": "https://oauth2.googleapis.com/token",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly"
    ],
    "redirect_port": 8724,
    "auth_extra_params": {
      "access_type": "offline",
      "prompt": "consent"
    }
  },
  "homepage": "https://calendar.google.com",
  "license": "GPL-3.0-only",
  "author": {
    "name": "fru-dev3",
    "url": "https://github.com/fru-dev3/prevail"
  },
  "refresh": {
    "every": "daily",
    "at": "06:00",
    "skill": "today-events"
  },
  "autonomy": "read-only",
  "account": {
    "label": "primary"
  },
  "connections": [
    {
      "kind": "mcp",
      "description": "Local Google Calendar MCP server. Set GCAL_MCP_COMMAND to the server binary.",
      "auth_check": {
        "kind": "env-keys",
        "env_keys": [
          "GCAL_MCP_COMMAND"
        ]
      },
      "skill": "today-events"
    },
    {
      "kind": "oauth",
      "description": "Google Calendar REST API via OAuth PKCE.",
      "auth_check": {
        "kind": "file-exists",
        "paths": [
          "~/.prevail/connectors/google-calendar/auth/refresh.token"
        ]
      },
      "skill": "today-events"
    }
  ]
}